# AI Threat Platform Backend Environment Configuration

# Server Host & Port (used for local Uvicorn development)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connection URL:
# - Local development (SQLite): sqlite:///./threat_intel.db
# - Vercel Serverless Demo: automatically falls back to sqlite:////tmp/threat_intel.db if unset
# - Production PostgreSQL (Neon / Supabase / Render): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./threat_intel.db

# CORS Allowed Origins (comma-separated):
# - Local dev: http://localhost:5173,http://127.0.0.1:5173
# - Production Vercel: https://your-deployment.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
